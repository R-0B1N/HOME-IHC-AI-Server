#!/usr/bin/expect -f
set timeout 60
spawn ssh -o StrictHostKeyChecking=no admin123@homeihc-ai-server "docker stop whatsapp_ai_api whatsapp_ai_worker whatsapp_ai_db whatsapp_ai_redis property-dashboard && docker rm -f whatsapp_ai_api whatsapp_ai_worker whatsapp_ai_db whatsapp_ai_redis property-dashboard && docker ps"
