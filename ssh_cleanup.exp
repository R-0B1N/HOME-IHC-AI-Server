#!/usr/bin/expect -f
set timeout 60
spawn ssh -o StrictHostKeyChecking=no admin123@homeihc-ai-server
expect {
    "*?assword:*" { send "P@ssw0rd\r" }
    timeout { puts "TIMEOUT"; exit 1 }
}
expect -re {.*[$#] }
send "docker stop whatsapp_ai_api whatsapp_ai_worker whatsapp_ai_db whatsapp_ai_redis property-dashboard\r"
expect -re {.*[$#] }
send "docker rm -f whatsapp_ai_api whatsapp_ai_worker whatsapp_ai_db whatsapp_ai_redis property-dashboard\r"
expect -re {.*[$#] }
send "exit\r"
expect eof
