#!/usr/bin/expect -f
set timeout 60
spawn ssh -o StrictHostKeyChecking=no admin123@homeihc-ai-server "docker rm -f whatsapp_ai_api_staging whatsapp_ai_worker_staging whatsapp_ai_db_staging whatsapp_ai_redis_staging whatsapp_ai_frontend_staging 2>/dev/null; docker network rm whatsapp-ai-staging_staging_net 2>/dev/null; echo '--- CLEANUP DONE ---'; docker ps --format '{{.Names}} - {{.Status}}'"
expect {
    "*?assword:*" { send "P@ssw0rd\r" }
    timeout { puts "TIMEOUT"; exit 1 }
}
expect eof
