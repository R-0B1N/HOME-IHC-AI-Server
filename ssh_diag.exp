#!/usr/bin/expect -f
set timeout 15
spawn ssh -o StrictHostKeyChecking=no admin123@homeihc-ai-server
expect {
    "*?assword:*" { send "P@ssw0rd\r" }
    timeout { puts "TIMEOUT"; exit 1 }
}
expect -re {.*[$#] }
send "ls -la /opt/crm\r"
expect -re {.*[$#] }
send "cat /opt/crm/docker-compose.yml\r"
expect -re {.*[$#] }
send "exit\r"
expect eof
