#!/usr/bin/expect -f
set timeout -1
spawn rsync -avz --dry-run -c --exclude '.git' --exclude '__pycache__' --exclude 'venv' -e "ssh -o StrictHostKeyChecking=no" backend/ admin123@homeihc-ai-server:/opt/crm/backend/
expect {
    "*?assword:*" {
        send "P@ssw0rd\r"
        exp_continue
    }
    eof
}
