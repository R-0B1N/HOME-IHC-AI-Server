#!/usr/bin/expect -f
set timeout 10

spawn ssh -t -o StrictHostKeyChecking=no admin123@homeihc-ai-server "sudo cp /tmp/config.yml /opt/crm/tunnel/config.yml && sudo cp /tmp/docker-compose.yml /opt/crm/docker-compose.yml && sudo cp -r /tmp/backend/* /opt/crm/backend/ && sudo chown -R admin123:admin123 /opt/crm/backend"
expect "*?assword:*"
send "P@ssw0rd\r"
expect "*?assword for admin123:*"
send "P@ssw0rd\r"
expect eof
