#!/usr/bin/expect -f
set timeout -1

# Upload config.yml
spawn scp -o StrictHostKeyChecking=no ./config.remote.yml admin123@homeihc-ai-server:/opt/crm/tunnel/config.yml
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

# Upload docker-compose.yml
spawn scp -o StrictHostKeyChecking=no ./docker-compose.remote.yml admin123@homeihc-ai-server:/opt/crm/docker-compose.yml
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

# Rsync backend
spawn rsync -avz --exclude 'venv' --exclude '__pycache__' --exclude '.env' -e "ssh -o StrictHostKeyChecking=no" ./backend/ admin123@homeihc-ai-server:/opt/crm/backend/
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

# Rsync property-dashboard
spawn rsync -avz --exclude 'node_modules' --exclude 'dist' -e "ssh -o StrictHostKeyChecking=no" ./property-dashboard/ admin123@homeihc-ai-server:/opt/crm/property-dashboard/
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

