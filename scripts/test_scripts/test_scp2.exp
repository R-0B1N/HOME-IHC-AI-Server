#!/usr/bin/expect -f
set timeout 10

spawn scp -o StrictHostKeyChecking=no ./config.remote.yml admin123@homeihc-ai-server:/home/admin123/config.yml
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

spawn scp -o StrictHostKeyChecking=no ./docker-compose.remote.yml admin123@homeihc-ai-server:/home/admin123/docker-compose.yml
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof
