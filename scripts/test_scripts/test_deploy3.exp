#!/usr/bin/expect -f
set timeout -1

# Upload docker-compose.yml to tmp
spawn scp -o StrictHostKeyChecking=no ./docker-compose.remote.yml admin123@homeihc-ai-server:/tmp/docker-compose.yml
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

# Upload backend to tmp
spawn rsync -avz --exclude 'venv' --exclude '__pycache__' --exclude '.env' -e "ssh -o StrictHostKeyChecking=no" ./backend/ admin123@homeihc-ai-server:/tmp/backend/
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

# Move files using sudo
spawn ssh -o StrictHostKeyChecking=no admin123@homeihc-ai-server "echo P@ssw0rd | sudo -S cp /tmp/docker-compose.yml /opt/crm/docker-compose.yml && sudo cp -r /tmp/backend/* /opt/crm/backend/ && sudo chown -R admin123:admin123 /opt/crm/backend"
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

