#!/usr/bin/expect -f
set timeout -1

# Upload config.yml to tmp
spawn scp -o StrictHostKeyChecking=no ./config.remote.yml admin123@homeihc-ai-server:/tmp/config.yml
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

# Upload property-dashboard to tmp
spawn rsync -avz --exclude 'node_modules' --exclude 'dist' -e "ssh -o StrictHostKeyChecking=no" ./property-dashboard/ admin123@homeihc-ai-server:/tmp/property-dashboard/
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

# Move files using sudo
spawn ssh -o StrictHostKeyChecking=no admin123@homeihc-ai-server "echo P@ssw0rd | sudo -S cp /tmp/config.yml /opt/crm/tunnel/config.yml && sudo cp -r /tmp/property-dashboard /opt/crm/ && sudo chown -R admin123:admin123 /opt/crm/property-dashboard"
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

