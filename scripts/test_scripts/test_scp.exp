#!/usr/bin/expect -f
set timeout 10
spawn scp -o StrictHostKeyChecking=no admin123@homeihc-ai-server:/opt/crm/docker-compose.yml ./docker-compose.remote.yml
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

spawn scp -o StrictHostKeyChecking=no admin123@homeihc-ai-server:/opt/crm/tunnel/config.yml ./config.remote.yml
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof
