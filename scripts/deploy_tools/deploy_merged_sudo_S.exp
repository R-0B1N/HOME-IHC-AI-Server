#!/usr/bin/expect -f
set timeout -1
spawn ssh -o StrictHostKeyChecking=no admin123@homeihc-ai-server "cd /opt/crm && echo P@ssw0rd | sudo -S bash -c 'cp /tmp/docker-compose.yml /opt/crm/docker-compose.yml && docker compose up -d'"
expect {
    "*?assword*" {
        send "P@ssw0rd\r"
        exp_continue
    }
    eof
}
