#!/usr/bin/expect -f
set timeout -1

spawn ssh -t -o StrictHostKeyChecking=no admin123@homeihc-ai-server "sudo bash -c 'cp /tmp/docker-compose.remote.yml /opt/crm/docker-compose.yml && cp /tmp/config.remote.yml /opt/crm/tunnel/config.yml && cp -r /tmp/backend/* /opt/crm/backend/ && rm -rf /opt/crm/property-dashboard/* && cp -r /tmp/property-dashboard/* /opt/crm/property-dashboard/ && chown -R admin123:admin123 /opt/crm/backend /opt/crm/property-dashboard && cd /opt/crm && docker compose up -d --build property-dashboard api worker cloudflared'"
expect {
    "*?assword*" {
        send "P@ssw0rd\r"
        exp_continue
    }
    eof
}
