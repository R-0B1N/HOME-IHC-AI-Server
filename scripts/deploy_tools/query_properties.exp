#!/usr/bin/expect -f
set timeout 30

spawn ssh -o StrictHostKeyChecking=no admin123@homeihc-ai-server "cd /opt/crm && echo P@ssw0rd | sudo -S docker compose exec whatsapp_ai_db psql -U n8n -d whatsapp_ai -c 'SELECT id, title, price, status FROM properties LIMIT 5;'"
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

spawn ssh -o StrictHostKeyChecking=no admin123@homeihc-ai-server "cd /opt/crm && echo P@ssw0rd | sudo -S docker compose exec property-dashboard ls -la /usr/share/nginx/html"
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof
