#!/usr/bin/expect -f
set timeout -1

spawn rsync -avz --exclude 'venv' --exclude '__pycache__' --exclude '.env' -e "ssh -o StrictHostKeyChecking=no" ./backend/ admin123@homeihc-ai-server:/tmp/backend/
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

spawn rsync -avz --exclude 'node_modules' --exclude 'dist' -e "ssh -o StrictHostKeyChecking=no" ./property-dashboard/ admin123@homeihc-ai-server:/tmp/property-dashboard/
expect "*?assword:*"
send "P@ssw0rd\r"
expect eof

spawn ssh -o StrictHostKeyChecking=no admin123@homeihc-ai-server "echo P@ssw0rd | sudo -S cp -r /tmp/backend/* /opt/crm/backend/ && sudo rm -rf /opt/crm/property-dashboard/* && sudo cp -r /tmp/property-dashboard/* /opt/crm/property-dashboard/ && sudo chown -R admin123:admin123 /opt/crm/backend /opt/crm/property-dashboard && cd /opt/crm && sudo docker compose down property-dashboard api worker && sudo docker compose up -d --build property-dashboard api worker"
expect {
    "*?assword*" {
        send "P@ssw0rd\r"
        exp_continue
    }
    eof
}
