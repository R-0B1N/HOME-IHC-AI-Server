{
  "name": "Debounce Example Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-debounce",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "debounce-example-id"
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "name": "Wait (Debounce)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://inbox.bentongland.com.my/api/v1/accounts/1/conversations/{{$json.body.conversation.id}}/messages",
        "authentication": "headerAuth",
        "options": {}
      },
      "name": "Get Latest Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        650,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "placeholder",
          "name": "Chatwoot API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [],
          "number": [
            {
              "value1": "={{$json.payload[0].id}}",
              "value2": "={{$('Webhook').item.json.body.id}}"
            }
          ]
        }
      },
      "name": "Is Latest Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {},
      "name": "Continue to AI",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1050,
        200
      ]
    },
    {
      "parameters": {},
      "name": "Stop (Spam)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1050,
        400
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Wait (Debounce)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait (Debounce)": {
      "main": [
        [
          {
            "node": "Get Latest Messages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Latest Messages": {
      "main": [
        [
          {
            "node": "Is Latest Message?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Latest Message?": {
      "main": [
        [
          {
            "node": "Continue to AI",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Stop (Spam)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
