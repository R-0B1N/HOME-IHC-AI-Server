#!/usr/bin/expect -f

set timeout 300
set host "homeihc-ai-server"
set user "admin123"
set password "P@ssw0rd"
set file "backend_deployment.tar.gz"

send_user "\n--- Creating deployment directory ---\n"
spawn ssh -o StrictHostKeyChecking=no $user@$host "mkdir -p ~/opt/crm"
expect "*assword:*"
send "$password\r"
expect eof

# 1. SCP the file
send_user "\n--- Uploading tarball ---\n"
spawn scp -o StrictHostKeyChecking=no $file $user@$host:~/opt/crm/
expect {
    "*assword:*" {
        send "$password\r"
        exp_continue
    }
    eof
}

# 2. SSH and execute commands
send_user "\n--- Executing remote deployment ---\n"
spawn ssh -o StrictHostKeyChecking=no $user@$host
expect "*assword:*"
send "$password\r"

expect {
    "$ " { send "cd ~/opt/crm\r" }
    "# " { send "cd ~/opt/crm\r" }
}

expect {
    "$ " { send "docker compose down\r" }
    "# " { send "docker compose down\r" }
}

expect {
    "$ " { send "tar -xzf backend_deployment.tar.gz\r" }
    "# " { send "tar -xzf backend_deployment.tar.gz\r" }
}

expect {
    "$ " { send "docker compose up -d --build\r" }
    "# " { send "docker compose up -d --build\r" }
}

expect {
    "$ " { send "exit\r" }
    "# " { send "exit\r" }
}

expect eof
send_user "\n--- Deployment complete ---\n"
